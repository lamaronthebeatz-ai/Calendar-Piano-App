% Common page settings for the engraved examples and pieces of the children's books:
% one system per page on a tall page, cropped afterwards by scripts/sheets/build.py.
\paper {
  paper-width = 150\mm
  paper-height = 400\mm
  line-width = 120\mm
  left-margin = 15\mm
  top-margin = 8\mm
  bottom-margin = 8\mm
  indent = 0
  short-indent = 0
  systems-per-page = 1
  ragged-bottom = ##t
  ragged-last-bottom = ##t
  print-page-number = ##f
  bookTitleMarkup = ##f
  scoreTitleMarkup = ##f
  oddHeaderMarkup = ##f
  evenHeaderMarkup = ##f
  oddFooterMarkup = ##f
  evenFooterMarkup = ##f
}
\header { tagline = ##f }
